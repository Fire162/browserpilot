# WebSocket + HTTP port for the BrowserPilot daemon (also reachable as PORT)
WS_PORT=8770

# Shared secret used by the extension popup and by `bp` clients.
#
# Leave this unset and the daemon generates a strong token on first start and
# stores it in ~/.browserpilot/.env (mode 0600). Paste that value into the
# extension popup. Never commit a real token, and never reuse the old public
# placeholder "browserpilot-secret" — the daemon refuses to start if you do.
#SECRET_TOKEN=

# Escape hatch: allow the known-public legacy token "browserpilot-secret".
# The daemon refuses to start with that value unless this is set. Leave it off.
#BROWSERPILOT_ALLOW_INSECURE_TOKEN=false

# Interface to bind. 0.0.0.0 is required for direct IP access from your laptop.
# Use 127.0.0.1 when a tunnel on this host is the only ingress.
BROWSERPILOT_BIND=0.0.0.0

# Additional browser origins allowed to call the HTTP API (comma separated).
# chrome-extension://* and loopback origins are always allowed.
#BROWSERPILOT_ALLOWED_ORIGINS=https://my-dashboard.example.com

# Dangerous capabilities are OFF unless explicitly enabled.
# ALLOW_CODE_EXECUTION enables browser_run_code / browser_evaluate (arbitrary JS
# inside your logged-in browser). ALLOW_COOKIE_ACCESS enables browser_get_cookies
# (exports session cookies to the agent).
ALLOW_CODE_EXECUTION=false
ALLOW_COOKIE_ACCESS=false

# Optional hardening knobs (defaults shown)
#BROWSERPILOT_MAX_BODY_BYTES=1048576
#BROWSERPILOT_AUTH_MAX_FAILURES=10
#BROWSERPILOT_AUTH_WINDOW_MS=60000
#BROWSERPILOT_AUTH_BLOCK_MS=60000
# Silence (ms) after which a connected bridge is treated as dead, so tool calls
# fail fast instead of waiting out their timeout. The extension pings every 15s.
#BROWSERPILOT_STALE_AFTER_MS=45000
